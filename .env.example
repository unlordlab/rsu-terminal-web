# ─────────────────────────────────────────────────────────────────────────────
# RSU Terminal — plantilla de configuración
#
# Cópiala a backend/.env y rellena lo que necesites:
#     cp .env.example backend/.env
#
# ⚠ DOS COSAS QUE TUMBAN EL ARRANQUE, comprobadas (28/07/2026):
#
#   1. Una variable que NO exista como campo en backend/config.py::Settings
#      hace fallar el arranque entero con ValidationError. No es teoría: pasó
#      en producción (502) al quitar OPENROUTER_API_KEY del código sin quitarla
#      del .env real. Ojo, la validación estricta aplica al FICHERO .env; una
#      variable de entorno suelta con ese nombre simplemente se ignora.
#      => No inventes variables aquí. Si añades una, añade antes su campo.
#
#   2. CORS_ORIGINS solo acepta formato JSON. Con comas falla con
#      SettingsError (el comentario de config.py que decía lo contrario era
#      incorrecto y se ha corregido).
#         BIEN:  CORS_ORIGINS=["https://tudominio.com","https://www.tudominio.com"]
#         MAL:   CORS_ORIGINS=https://tudominio.com,https://www.tudominio.com
#
# Todos los campos tienen valor por defecto: puedes arrancar en local sin
# rellenar nada. Cada clave vacía degrada su módulo con elegancia (se muestra
# "sin datos"), nunca inventa un valor — salvo las dos de la sección 1, que en
# producción son obligatorias.
# ─────────────────────────────────────────────────────────────────────────────

# ── 1. OBLIGATORIAS EN PRODUCCIÓN ────────────────────────────────────────────
# Con ENVIRONMENT=production, el validador de config.py CORTA EL ARRANQUE si
# estas dos siguen con su valor por defecto. Es deliberado: mejor no arrancar
# que arrancar con credenciales públicas y conocidas.
ENVIRONMENT=development
SECRET_KEY=cambia_esto_por_una_clave_larga_y_aleatoria
# Clave de los endpoints de administración (/api/v1/auth/admin/*), enviada en
# la cabecera X-Admin-Key. Permite cambiar tiers, resetear contraseñas y
# revocar sesiones — trátala como la credencial más sensible del proyecto.
ADMIN_KEY=cambia_esto_por_otra_clave_distinta

# ── 2. APLICACIÓN ────────────────────────────────────────────────────────────
# CORS_ORIGINS=["https://tudominio.com"]        # JSON obligatorio, ver aviso 2
# APP_NAME=RSU Terminal
# ALGORITHM=HS256
# TOKEN_EXPIRE_MINUTES=480
# TERMINAL_BASE_URL=https://tudominio.com       # se usa en los enlaces de Telegram
# Capital de referencia para el sizing por niveles Core/High/Lottery de Cartera
# CAPITAL_TOTAL=100000

# ── 3. DATOS DE MERCADO ──────────────────────────────────────────────────────
# Hoja de cálculo publicada como CSV con las posiciones de Cartera
URL_CARTERA=
FINNHUB_API_KEY=
FMP_API_KEY=
FRED_API_KEY=
# Uso marginal (una función de Research). Ver PRECIOS_Y_APIS.md: la
# recomendación es retirarla, no pagarla — Finnhub da lo mismo.
ALPHA_VANTAGE_API_KEY=
# Proxy para TODAS las llamadas a yfinance. Vacío = sin proxy. Existe porque
# Yahoo bloquea IPs de datacenter; hoy está sin contratar.
# Formato: http://usuario:contraseña@host:puerto
YFINANCE_PROXY_URL=

# ── 4. MODELOS DE IA (agentes y chat) ────────────────────────────────────────
GROQ_API_KEY=              # Daily Briefing, Elia, chat
ANTHROPIC_API_KEY=         # Gael en modo producción
GEMINI_API_KEY=            # Gael en modo prueba gratuito
XAI_API_KEY=
# Sin uso en código todavía, pero SÍ presente en el .env real: si la quitas de
# aquí, quítala también del .env del VPS o el arranque fallará (ver aviso 1).
OPENROUTER_API_KEY=

# ── 5. TELEGRAM ──────────────────────────────────────────────────────────────
# Bot creado con @BotFather. El mismo bot sirve para los tres usos de abajo.
TELEGRAM_BOT_TOKEN=
# Canal/grupo COMUNITARIO: cambios de semáforo del Algoritmo, Cartera, tesis.
# Lo ven todos los usuarios suscritos. Para un canal empieza por "-100...".
TELEGRAM_CHAT_ID=
# Chat PERSONAL del admin, para avisos privados (feedback de Community, que
# puede traer quejas o datos de contacto). No es el canal de arriba.
TELEGRAM_ADMIN_CHAT_ID=
# @handle público del bot, SIN la arroba. Necesario para el enlace de
# vinculación t.me/<handle>?start=<código> de las alertas de Watchlist.
TELEGRAM_BOT_USERNAME=

# ── 6. REDDIT (widget Reddit Pulse) ──────────────────────────────────────────
# App tipo "script" registrada gratis en reddit.com/prefs/apps. Vacío = el
# widget funciona igual, con el resto de fuentes disponibles.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=RSUTerminal/1.0 (by /u/tu_usuario)
